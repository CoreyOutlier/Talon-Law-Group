# Where intake form submissions are delivered.
# Any endpoint that accepts a JSON POST: Zapier, Make, a CRM, a Slack webhook.
# Without this, leads are logged to the server console and go nowhere.
INTAKE_WEBHOOK_URL=

# Set to 1 in local dev to preview unverified case results and testimonials.
# NEVER set this in production.
NEXT_PUBLIC_SHOW_DRAFT_PROOF=
